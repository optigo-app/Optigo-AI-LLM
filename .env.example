# FastAPI chatbot service configuration
NODE_API_BASE=Your Node API Base URL
REGISTRY_PATH=app/registry.json
CACHE_DIR=./cache_data

# Real report API (Optigoapps report endpoint)
USE_REAL_API=true
REAL_API_BASE_URL=Your Real API Base URL
REAL_API_TIMEOUT=60.0
# Static session values for the chatbot SP
REAL_API_YEARCODE=Your Real API Year Code
REAL_API_SP=Your Real API SP
REAL_API_SV=Your Real API SV
REAL_API_VERSION=Your Real API Version
# Shared LLM-chat SP number. When > 0, chat-mode requests route to this
# metadata-driven SP instead of each report's own SP.
# 0 = disabled (use each report's own SP — legacy behaviour).
REAL_API_LLM_CHAT_SP=Your Real API LLM Chat SP

# Operational constants
LLM_SAFE_ROW_LIMIT=50
GRID_ROW_LIMIT=500
BREAKDOWN_ROW_LIMIT=100
CACHE_SIMILARITY_THRESHOLD=0.93
CACHE_TTL_SECONDS=3600
CACHE_SCHEMA_VERSION=v2
CLASSIFIER_SIMILARITY_THRESHOLD=0.60
RETRIEVAL_TOP_K=5
RETRIEVAL_RERANK=false
PROMPT_CACHING=false

# Model routing
CHEAP_LLM_PROVIDER=gemini
CHEAP_LLM_MODEL=gemini-flash-lite
STRONG_LLM_PROVIDER=anthropic
STRONG_LLM_MODEL=claude-3-7-sonnet-latest
EMBEDDING_MODEL=text-embedding-3-small

# LLM API keys (set at least the one matching CHEAP_LLM_PROVIDER / STRONG_LLM_PROVIDER)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security
AUTH_REQUIRED=true
# Admin key for operational endpoints (/cache/invalidate, /feedback/stats,
# /feedback/down, detailed /health). Required in production; send as
# X-Admin-Key header. Leave empty only for local dev.
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=60
MAX_QUESTION_LENGTH=1000
CORS_ORIGINS=*

# LLM retry
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY=0.5

# Wide response mode (structured blocks) — comma-separated company codes
# Leave empty to require explicit response_mode="wide" per request.
WIDE_RESPONSE_COMPANIES=
