      }
    },
    "SoldPending": {
      "sql": "",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.Job_Quantity,0)>0 AND ISNULL(DI.job_RemainingQuantity,0)=0 THEN 'sold' WHEN ISNULL(DI.Job_Quantity,0)>0 AND ISNULL(DI.job_RemainingQuantity,0)<>0 THEN 'pending' ELSE '' END",
