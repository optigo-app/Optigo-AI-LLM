    "orders": {
      "sql": "",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.IsSampleLineJob,0)=0 AND ISNULL(DI.jobflowfrom,'')<>'ReceiveToRepair' THEN 'Regular jobs' WHEN ISNULL(DI.IsSampleLineJob,0)=1 AND ISNULL(DI.jobflowfrom,'')<>'ReceiveToRepair' THEN 'Sample line jobs' ELSE '' END",
      "desc": "Order Class",
      "grp": "order",
      "filter": {
        "match": "exact",
        "aliases": [
          "order type",
          "job type",
          "order classification"
        ]
      }
    },
    "orderType": {
      "sql": "",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.OrderTypeId,0)=1 THEN 'Regular' WHEN ISNULL(DI.OrderTypeId,0)=2 THEN 'Corporate' ELSE '' END",
      "desc": "Order Type",
      "grp": "order",
      "filter": {
        "match": "exact",
        "aliases": [
