    "GrossWt": {
      "sql": "",
      "type": "decimal",
      "calc": true,
      "me": "(SELECT ISNULL(SUM(ISNULL(GrossCTWWithLoss,0)*ISNULL(Quantity,0)),0) FROM {DBNAME}Quotationmanagement_dcbdesignInfo WHERE job_JobNo = DI.JobNo)+(SELECT ISNULL(SUM(ISNULL(GrossCTWWithLoss,0)*ISNULL(Quantity,0)),0) FROM {DBNAME}Quotationmanagement_dcbdesignInfo_Archive WHERE job_JobNo = DI.JobNo AND IsQuotationJobBillArchived=3)",
      "desc": "Gross Wt",
      "grp": "weight",
      "unit": "gms",
      "not_in_where": true,
      "aliases": [
        "gross weight",
        "gross wt",
        "total weight"
      ]
    },
    "NetWt": {
      "sql": "",
      "type": "decimal",
      "calc": true,
      "me": "(SELECT ISNULL(SUM(ISNULL(Netwt,0)*ISNULL(Quantity,0)),0) FROM {DBNAME}Quotationmanagement_dcbdesignInfo WHERE job_JobNo = DI.JobNo)+(SELECT ISNULL(SUM(ISNULL(Netwt,0)*ISNULL(Quantity,0)),0) FROM {DBNAME}Quotationmanagement_dcbdesignInfo_Archive WHERE job_JobNo = DI.JobNo AND IsQuotationJobBillArchived=3)",
      "desc": "Net Wt",
      "grp": "weight",
      "unit": "gms",
      "not_in_where": true,
      "aliases": [
        "net weight",
        "net wt"
      ]
    },
    "PureWt": {
      "sql": "",
      "type": "decimal",
      "calc": true,
      "me": "(SELECT ISNULL(SUM(CONVERT(DECIMAL(38,3),CASE WHEN ISNULL(mp_both.price_ratio,0)>0 AND ISNULL(mp_to.price_ratio,0)>0 THEN ISNULL(a.Netwt,0)*ISNULL(a.Quantity,0)*mp_both.price_ratio/mp_to.price_ratio ELSE ISNULL(a.Netwt,0)*ISNULL(a.Quantity,0)*ISNULL(mp_concat.price_ratio,0)/100 END)),0) FROM {DBNAME}Quotationmanagement_dcbdesignInfo a LEFT JOIN {DBNAME}Mastermanagement_metaltype b ON a.MasterManagement_goldtypeid=b.autocode LEFT JOIN {DBNAME}Mastermanagement_MetalPurity mp_to ON b.metaltypename=mp_to.metaltypename AND mp_to.IsBaseMetal=1 LEFT JOIN {DBNAME}Mastermanagement_MetalPurity mp_both ON b.metaltypename=mp_both.metaltypename AND b.metalPurity=mp_both.metalPurity LEFT JOIN {DBNAME}Mastermanagement_MetalPurity mp_concat ON CONCAT(mp_concat.metaltypename,' ',mp_concat.metalPurity)=b.metalPurity WHERE a.job_JobNo = DI.JobNo)+(SELECT ISNULL(SUM(CONVERT(DECIMAL(38,3),CASE WHEN ISNULL(mp_both.price_ratio,0)>0 AND ISNULL(mp_to.price_ratio,0)>0 THEN ISNULL(a.Netwt,0)*ISNULL(a.Quantity,0)*mp_both.price_ratio/mp_to.price_ratio ELSE ISNULL(a.Netwt,0)*ISNULL(a.Quantity,0)*ISNULL(mp_concat.price_ratio,0)/100 END)),0) FROM {DBNAME}Quotationmanagement_dcbdesignInfo_Archive a LEFT JOIN {DBNAME}Mastermanagement_metaltype b ON a.MasterManagement_goldtypeid=b.autocode LEFT JOIN {DBNAME}Mastermanagement_MetalPurity mp_to ON b.metaltypename=mp_to.metaltypename AND mp_to.IsBaseMetal=1 LEFT JOIN {DBNAME}Mastermanagement_MetalPurity mp_both ON b.metaltypename=mp_both.metaltypename AND b.metalPurity=mp_both.metalPurity LEFT JOIN {DBNAME}Mastermanagement_MetalPurity mp_concat ON CONCAT(mp_concat.metaltypename,' ',mp_concat.metalPurity)=b.metalPurity WHERE a.job_JobNo = DI.JobNo AND a.IsQuotationJobBillArchived=3)",
      "desc": "Pure Wt",
      "grp": "weight",
      "unit": "gms",
      "not_in_where": true,
      "aliases": [
        "pure weight",
        "pure wt",
        "net pure wt"
      ]
    },
