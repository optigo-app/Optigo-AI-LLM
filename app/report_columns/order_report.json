  "prompt_rules": {
    "special_rules": [
      "Order report covers job orders (not customized, not bulk, not retail, not deleted). Jobs must have a valid SKUNO.",
      "Order data comes from JobManagement_JobMaster. Quotation metrics (weights, amounts) are computed from Quotationmanagement_dcbdesignInfo via job_JobNo.",
      "Amount is the total order value (FinalAmount from quotation). Use Amount for 'total order value/amount' questions.",
      "Weights are in grams (GrossWt, NetWt, PureWt, MiscWt) except diamond/colourstone which are in carat (DiaWt, CSWt).",
      "orders dimension classifies jobs as: Regular jobs, Sample line jobs. orderType dimension classifies as: Regular, Corporate.",
      "SoldPending dimension shows 'sold' (remaining qty = 0) or 'pending' (remaining qty > 0).",
      "ETAJobs counts jobs with ProgressStatusMasterid NOT IN (1,12). RemJobs counts jobs with ProgressStatusMasterid IN (1,12)."
    ],
    "negative_examples": [
      "total tax -> NOT applicable to order report (no tax columns)",
      "sales amount -> NOT applicable to order report (use Amount for order value)",
      "wip cost -> NOT applicable to order report (use Amount for order value)"
    ]
  },
  "intents": {
    "order_total_amount": {
      "patterns": [
        "\\b(total\\s+order\\s+(amount|value|total)|order\\s+(total\\s+)?(amount|value)|total\\s+amount|order\\s+total)\\b"
      ],
      "metric": "Amount",
      "aggregation": "sum",
      "unit": "currency",
      "label": "Total order amount"
    },
    "order_count": {
      "patterns": [
        "\\b(how\\s+many\\s+\\w*\\s*(orders?|jobs?)|orders?\\s+count|number\\s+of\\s+\\w*\\s*(orders?|jobs?)|total\\s+orders?)\\b"
      ],
      "metric": "total_count",
      "aggregation": "count",
      "unit": "count",
      "label": "Order count"
    },
    "order_customer_ranking": {
      "patterns": [
        "\\b(top\\s+\\d*\\s*customers?\\s+(by\\s+)?(orders?|order\\s+value))\\b",
        "\\b(orders?|order\\s+value)\\b[^.]{0,80}(by\\s+customer|customer[-\\s]wise)\\b",
        "\\b(by\\s+customer|customer[-\\s]wise)[^.]{0,80}\\b(orders?|order\\s+value)\\b"
      ],
      "metric": "Amount",
      "aggregation": "sum",
      "dimension": "Job_customercode",
      "sort": "desc",
      "limit": 5,
      "unit": "currency",
      "label": "top customer by order value"
    },
    "order_company_ranking": {
      "patterns": [
        "\\b(top\\s+\\d*\\s*(compan(?:y|ies)|firms?)\\s+(by\\s+)?(orders?|order\\s+value))\\b",
        "\\b(orders?|order\\s+value)\\b[^.]{0,80}(by\\s+company|company[-\\s]wise|by\\s+firm|firm[-\\s]wise)\\b",
        "\\b(by\\s+company|company[-\\s]wise|by\\s+firm|firm[-\\s]wise)[^.]{0,80}\\b(orders?|order\\s+value)\\b"
      ],
      "metric": "Amount",
      "aggregation": "sum",
      "dimension": "Job_customerfirmname",
      "sort": "desc",
      "limit": 5,
      "unit": "currency",
      "label": "top company by order value"
    },
    "order_salesrep_list": {
      "patterns": [
        "\\b(all\\s+)?(sales\\s*reps?|salespersons?)\\s+list\\b",
        "\\blist\\s+(all\\s+)?(sales\\s*reps?|salespersons?)\\b",
        "\\bshow\\s+(all\\s+)?(sales\\s*reps?|salespersons?)\\b"
      ],
      "metric": "total_count",
      "aggregation": "count",
      "dimension": "SalesrepCode",
      "sort": "desc",
      "limit": 50,
      "unit": "count",
      "label": "Sales rep list"
    },
    "order_salesrep_ranking": {
      "patterns": [
        "\\b(top\\s+\\d*\\s*(sales\\s*reps?|salespersons?)\\s+(by\\s+)?(orders?|order\\s+value))\\b",
        "\\b(orders?|order\\s+value)\\b[^.]{0,80}(by\\s+sales\\s*rep|sales\\s*rep[-\\s]wise)\\b",
        "\\b(by\\s+sales\\s*rep|sales\\s*rep[-\\s]wise)[^.]{0,80}\\b(orders?|order\\s+value)\\b",
        "\\b(salespersons?|sales\\s*persons?|sales\\s*agents?|employees?|staff)\\b.*\\b(orders?|order\\s+value|generat\\w*|most|highest|top|rank\\w*|performance|sold)\\b",
        "\\b(who|which\\s+(salesperson|sales\\s*person|sales\\s*rep|employee|staff|agent))\\b.*\\b(generat\\w*|made|closed|sold|orders?|most|highest)\\b",
        "\\b(top|best|highest|biggest)\\s+\\d*\\s*(salespersons?|sales\\s*persons?|sales\\s*reps?|employees?|staff|agents?)\\b"
      ],
      "metric": "Amount",
      "aggregation": "sum",
      "dimension": "SalesrepCode",
      "sort": "desc",
      "limit": 5,
