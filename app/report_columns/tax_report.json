{
  "description": "Tax report — total tax, GST, and individual tax breakdowns from invoice documents",
  "sp": 245,
  "report_id": 20,
  "default_metric": "TotalTax",
  "default_dimension": "",
  "tables": [
    "Stockmanagement_dcb"
  ],
  "base_filter": "Stockmanagement_Statusid = 16 AND StockDocumentNo != ''",
  "masters": [
    "billmode",
    "taxfilter"
  ],
  "columns": {
    "EntryDate": {
      "sql": "entrydate",
      "type": "date",
      "desc": "Invoice entry date",
      "grp": "date"
    },
    "StockDocumentNo": {
      "sql": "StockDocumentNo",
      "type": "string",
      "desc": "Invoice/document number",
      "grp": "inventory",
      "filter": {
        "match": "exact",
        "aliases": [
          "invoice",
          "bill",
          "invoice no"
        ],
        "id_pattern": "Invoice#"
      }
    },
    "TotalTax": {
      "sql": "totaltaxAmount",
      "type": "decimal",
      "desc": "Total tax amount on the invoice",
      "grp": "financial"
    },
    "billmode": {
      "sql": "billmode",
      "type": "string",
      "calc": true,
      "de": "ISNULL(DI.billmode,'')",
      "desc": "Bill Mode (Jewellery Sale / Labour Sale / Repair Sale)",
      "grp": "sale",
      "filter": {
        "match": "like",
        "aliases": [
          "bill mode",
          "sale mode",
          "sale type",
          "bill type",
          "mode"
        ]
      }
    },
    "taxfilter": {
      "sql": "taxfilter",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.TotalGSTAmount,0)+ISNULL(DI.totaltaxAmount,0)>0 THEN 'With Tax' ELSE 'Without Tax' END",
      "desc": "Tax mode (With Tax / Without Tax)",
      "grp": "financial",
      "filter": {
        "match": "exact",
        "aliases": [
          "tax mode",
          "tax filter",
          "with tax",
          "without tax",
          "tax status"
        ]
      }
    },
    "TotalGST": {
      "sql": "TotalGSTAmount",
      "type": "decimal",
      "desc": "Total GST amount on the invoice",
      "grp": "financial"
    },
    "Tax1Amount": {
      "sql": "tax1Amount",
      "type": "decimal",
      "desc": "Tax 1 amount (e.g. CGST)",
      "grp": "financial"
    },
    "Tax2Amount": {
      "sql": "tax2Amount",
      "type": "decimal",
      "desc": "Tax 2 amount (e.g. IGST)",
      "grp": "financial"
    },
    "Tax3Amount": {
      "sql": "tax3Amount",
      "type": "decimal",
      "desc": "Tax 3 amount (e.g. SGST)",
      "grp": "financial"
    },
    "Tax4Amount": {
      "sql": "tax4Amount",
      "type": "decimal",
      "desc": "Tax 4 amount",
      "grp": "financial"
    },
    "Tax5Amount": {
      "sql": "tax5Amount",
      "type": "decimal",
      "desc": "Tax 5 amount",
      "grp": "financial"
    },
    "Tax1Name": {
      "sql": "tax1_taxname",
      "type": "string",
      "desc": "Tax 1 name (e.g. CGST, SGST, IGST)",
      "grp": "financial"
    },
    "Tax2Name": {
      "sql": "tax2_taxname",
      "type": "string",
      "desc": "Tax 2 name",
      "grp": "financial"
    },
    "Tax3Name": {
      "sql": "tax3_taxname",
      "type": "string",
      "desc": "Tax 3 name",
      "grp": "financial"
    },
    "month": {
      "sql": "",
      "type": "string",
      "calc": true,
      "de": "CONVERT(varchar(7), DI.EntryDate, 120)",
      "desc": "Month",
      "grp": "date"
    },
    "year": {
      "sql": "",
      "type": "string",
      "calc": true,
      "de": "CONVERT(varchar(4), DI.EntryDate, 120)",
      "desc": "Year",
      "grp": "date"
    },
    "week": {
      "sql": "",
      "type": "string",
      "calc": true,
      "de": "CONVERT(varchar(4), YEAR(DI.EntryDate)) + '-W' + RIGHT('0' + CONVERT(varchar(2), DATEPART(ISO_WEEK, DI.EntryDate)), 2)",
      "desc": "Week (ISO)",
      "grp": "date"
    }
  },
  "special_metrics": {
    "total_count": {
      "sql": "id",
      "type": "count",
      "description": "Total invoice count"
    }
  },
  "dimension_aliases": {
    "bill": "StockDocumentNo",
    "bill no": "StockDocumentNo",
    "invoice": "StockDocumentNo",
    "invoice no": "StockDocumentNo",
    "document": "StockDocumentNo",
    "bill mode": "billmode",
    "sale mode": "billmode",
    "sale type": "billmode",
    "bill type": "billmode",
    "tax mode": "taxfilter",
    "tax status": "taxfilter"
  },
  "filter_key_map": {
    "bill_mode": "billmode",
    "billmode": "billmode",
    "sale_mode": "billmode",
    "sale_type": "billmode",
    "bill_type": "billmode",
    "tax_mode": "taxfilter",
    "taxfilter": "taxfilter",
    "tax_status": "taxfilter",
    "start_date": "_date",
    "end_date": "_date"
  },
  "canonical_values": {
    "billmode": {
      "jewelry": "ewel",
      "jewellery": "ewel",
      "jewelry sale": "ewel",
      "jewellery sale": "ewel",
      "jewelery": "ewel",
      "labour": "abour",
      "labor": "abor",
      "labour sale": "abour",
      "labor sale": "abor",
      "repair": "Repair",
      "repairs": "Repair",
      "repair sale": "Repair",
      "repairing": "Repair"
    },
    "taxfilter": {
      "with tax": "With Tax",
      "tax": "With Tax",
      "taxable": "With Tax",
      "with gst": "With Tax",
      "without tax": "Without Tax",
      "no tax": "Without Tax",
      "non tax": "Without Tax",
      "nontax": "Without Tax",
      "non taxable": "Without Tax",
      "without gst": "Without Tax",
      "exempt": "Without Tax"
    }
  },
  "metric_catalog": {
    "TotalTax": {
      "type": "amount",
      "label": "Total tax",
      "aliases": [
        "total tax",
        "tax amount",
        "tax"
      ]
    },
    "TotalGST": {
      "type": "amount",
      "label": "Total GST",
      "aliases": [
        "total gst",
        "gst amount",
        "gst"
      ]
    },
    "Tax1Amount": {
      "type": "amount",
      "label": "Tax 1 amount",
      "aliases": [
        "tax 1",
        "cgst"
      ]
    },
    "Tax2Amount": {
      "type": "amount",
      "label": "Tax 2 amount",
      "aliases": [
        "tax 2",
        "igst"
      ]
    },
    "Tax3Amount": {
      "type": "amount",
      "label": "Tax 3 amount",
      "aliases": [
        "tax 3",
        "sgst"
      ]
    },
    "Tax4Amount": {
      "type": "amount",
      "label": "Tax 4 amount",
      "aliases": [
        "tax 4"
      ]
    },
    "Tax5Amount": {
      "type": "amount",
      "label": "Tax 5 amount",
      "aliases": [
        "tax 5"
      ]
    },
    "total_count": {
      "type": "count",
      "label": "Invoice count",
      "companions": [
        "TotalTax"
      ],
      "aliases": [
        "invoice count",
        "bill count",
        "how many invoices"
      ]
    }
  },
  "report_keywords": [
    "tax",
    "gst",
    "cgst",
    "sgst",
    "igst",
    "tcs",
    "hsn",
    "total tax",
    "total gst",
    "tax amount",
    "gst amount",
    "tax collected",
    "tax collection",
    "tax liability",
    "tax summary",
    "tax report",
    "tax breakup",
    "gst breakup",
    "gst collected",
    "bill wise tax",
    "tax wise",
    "monthly tax",
    "tax register"
  ],
  "date_column": "EntryDate",
  "intents": {
    "tax_total": {
      "patterns": [
        "\\b(total\\s+tax|tax\\s+(amount|total|collected|collection|liability|summary))\\b"
      ],
      "metric": "TotalTax",
      "aggregation": "sum",
      "unit": "currency",
      "label": "Total tax"
    },
    "gst_total": {
      "patterns": [
        "\\b(total\\s+gst|gst\\s+(amount|total|collected|collection|breakup)|gst\\s+liability)\\b"
      ],
      "metric": "TotalGST",
      "aggregation": "sum",
      "unit": "currency",
      "label": "Total GST"
    },
    "bill_wise_tax": {
      "patterns": [
        "\\b((bill|invoice|document)\\s*wise\\s*tax|tax\\s+(per|by)\\s+(bill|invoice|document)|tax\\s+by\\s+bill)\\b"
      ],
      "metric": "TotalTax",
      "aggregation": "sum",
      "dimension": "StockDocumentNo",
      "sort": "desc",
      "limit": 10,
      "unit": "currency",
      "label": "Tax by bill"
    },
    "cgst": {
      "patterns": [
        "\\bcgst\\b"
      ],
      "metric": "Tax1Amount",
      "aggregation": "sum",
      "unit": "currency",
      "label": "CGST"
    },
    "igst": {
      "patterns": [
        "\\bigst\\b"
      ],
      "metric": "Tax2Amount",
      "aggregation": "sum",
      "unit": "currency",
      "label": "IGST"
    },
    "sgst": {
      "patterns": [
        "\\bsgst\\b"
      ],
      "metric": "Tax3Amount",
      "aggregation": "sum",
      "unit": "currency",
      "label": "SGST"
    }
  },
  "fallback_intent": {
    "patterns": [
      "tax",
      "gst",
      "tcs",
      "hsn"
    ],
    "intent": "tax_total",
    "metric": "TotalTax",
    "aggregation": "sum",
    "unit": "currency"
  },
  "prompt_rules": {
    "special_rules": [
      "Tax breakdown: if user asks for CGST/SGST/IGST specifically, map to Tax1Amount/Tax3Amount/Tax2Amount respectively.",
      "Total tax = TotalTax. Total GST = TotalGST. These may differ if non-GST taxes exist.",
      "This report only has EntryDate, StockDocumentNo and tax amount columns. Never emit customer, category, design, or other unsupported filters or dimensions."
    ]
  },
  "suggested_questions": [
    "total tax this month",
    "total gst amount",
    "today tax summary",
    "tax wise breakdown"
  ]
}
