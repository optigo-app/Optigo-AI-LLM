    "jobtype": {
      "sql": "jobtype",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.IsQuickRepairing,0) = 1 AND ISNULL(DI.Ismfgjob,0) = 0 THEN 'Repair Job' WHEN ISNULL(DI.REcnt,0) = 0 AND ISNULL(DI.ReverseEngage_parent_serialjobno,'') <> '' THEN 'Recast Job' WHEN (ISNULL(DI.IsSampleLineJob,0) = 0 AND ISNULL(DI.isquickrepairing,0) = 0) OR (ISNULL(DI.IsSampleLineJob,0) = 0 AND ISNULL(DI.Ismfgjob,0) = 1 AND ISNULL(DI.isquickrepairing,0) = 1) THEN 'Regular Job' WHEN (ISNULL(DI.IsSampleLineJob,0) = 1 AND ISNULL(DI.Ismfgjob,0) = 0 AND ISNULL(DI.isquickrepairing,0) = 0) OR (ISNULL(DI.IsSampleLineJob,0) = 1 AND ISNULL(DI.Ismfgjob,0) = 1 AND ISNULL(DI.isquickrepairing,0) = 1) THEN 'Sample Line Job' ELSE '' END",
      "desc": "Job classification (Regular / Sample Line / Repair / Recast)",
      "grp": "manufacturing",
      "filter": {
        "match": "exact",
        "aliases": [
          "job type",
          "jobtype"
        ]
      }
    },
    "withpip": {
