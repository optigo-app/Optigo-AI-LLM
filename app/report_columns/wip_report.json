    "JobLocation": {
      "sql": "JobLocation",
      "type": "string",
      "calc": true,
      "de": "IIF(ISNULL(DI.Mastermanagement_TransferTo_MFGJobLocationid,0) = 0, ISNULL(DI.Mastermanagement_MFG_JobLastLocationname,''), CONCAT(ISNULL(DI.Mastermanagement_MFG_JobLastLocationname,''), ' > ', ISNULL(DI.Mastermanagement_TransferTo_MFGJobLocationname,'')))",
      "desc": "Job manufacturing location",
      "grp": "manufacturing",
      "filter": {
        "match": "exact",
        "aliases": [
          "location",
          "job location"
        ]
      }
    },
    "workername": {
      "sql": "workername",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.AssignEmployee_MiddleName,'') <> '' THEN ISNULL(DI.AssignEmployee_FirstName,'') + ' ' + ISNULL(DI.AssignEmployee_MiddleName,'') + ' ' + ISNULL(DI.AssignEmployee_LastName,'') ELSE ISNULL(DI.AssignEmployee_FirstName,'') + ' ' + ISNULL(DI.AssignEmployee_LastName,'') END",
      "desc": "Assigned worker name",
      "grp": "manufacturing",
      "filter": {
        "match": "like",
        "aliases": [
          "worker",
          "employee",
          "assigned to",
          "karigar",
          "staff",
          "agent",
          "salesperson",
          "sales person"
        ]
      }
    },
    "LastProcessedBy": {
      "sql": "LastProcessedBy",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.AssignEmployee_FirstName,'') <> '' AND ISNULL(DI.AssignEmployee_LastName,'') <> '' THEN ISNULL(DI.AssignEmployee_FirstName,'') + ' ' + ISNULL(DI.AssignEmployee_LastName,'') ELSE ISNULL(DI.LastProcessedBy_Name,'') END",
      "desc": "Last processed by",
      "grp": "manufacturing"
