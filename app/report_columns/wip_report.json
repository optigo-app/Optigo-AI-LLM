    "size": {
      "sql": "size",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN ISNULL(DI.mastermanagement_categoryid,0) = 1 THEN DI.Ring_FingerSize WHEN ISNULL(DI.mastermanagement_categoryid,0) = 2 THEN DI.PendentBailType WHEN ISNULL(DI.mastermanagement_categoryid,0) = 3 THEN DI.BraceletLength WHEN ISNULL(DI.mastermanagement_categoryid,0) = 4 THEN DI.BangelInsideDiameter WHEN ISNULL(DI.mastermanagement_categoryid,0) = 5 THEN DI.EaringLength WHEN ISNULL(DI.mastermanagement_categoryid,0) = 6 THEN DI.NecklaceLength WHEN ISNULL(DI.mastermanagement_categoryid,0) = 7 THEN DI.MiscellaneousFingersize ELSE DI.othersize END",
      "desc": "Jewellery size (varies by category)",
      "grp": "product"
    },
    "department": {
      "sql": "department",
      "type": "string",
      "calc": true,
      "de": "CASE WHEN (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isEngage,0) = 1 AND ISNULL(DI.isWaxEngage,0) = 0) OR (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isEngage,0) = 1 AND ISNULL(DI.isWaxEngage,0) <> 0 AND ISNULL(DI.Engage_Lastproductionstatusid,0) = 33) THEN 'Bagging Running' WHEN (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isEngage,0) = 2 AND ISNULL(DI.isWaxEngage,0) = 0) OR (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isEngage,0) = 2 AND ISNULL(DI.isWaxEngage,0) <> 0 AND ISNULL(DI.Engage_Lastproductionstatusid,0) = 34) THEN 'Bagging Completed' WHEN (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isWaxEngage,0) = 1 AND ISNULL(DI.isEngage,0) = 0) OR (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isWaxEngage,0) = 1 AND ISNULL(DI.isEngage,0) <> 0 AND ISNULL(DI.Engage_Lastproductionstatusid,0) = 40) THEN 'Wax Engage Running' WHEN (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isWaxEngage,0) = 2 AND ISNULL(DI.isEngage,0) = 0) OR (ISNULL(DI.MasterManagement_productionstatusid,0) = 1 AND ISNULL(DI.isWaxEngage,0) = 2 AND ISNULL(DI.isEngage,0) <> 0 AND ISNULL(DI.Engage_Lastproductionstatusid,0) = 41) THEN 'Wax Engage Completed' WHEN ISNULL(DI.MasterManagement_productionstatusid,0) = 28 AND ISNULL(DI.isoutsource,0) = 1 THEN 'Out Source' ELSE ISNULL(DI.productionstatusname,'') END",
      "desc": "Current production department / status",
      "grp": "manufacturing",
      "filter": {
        "match": "exact",
        "aliases": [
          "department",
          "status",
          "production status",
          "stage"
        ]
      }
    },
